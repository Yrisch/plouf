#!/usr/bin/env bash
# plouf: camera paths through SPH simulations, rendered with shamrock
# Copyright (c) 2026 the plouf authors
# SPDX-License-Identifier: CECILL-2.1
# plouf is licensed under the CeCILL 2.1 License, see LICENSE for more information
# plouf launcher
#   ./plouf [dumps ...] [--path campath.json]     camera path editor
#   ./plouf render campath.json [options]         batch movie render
#   ./plouf test [pytest options]                 run the tests (tests/)
# Environment (see README.md, "Installation"):
#   PLOUF_PYTHON     python interpreter to use (default: python3 on PATH, e.g. the active venv)
#   SHAMROCK_BUILD   shamrock build directory holding pysham/ (default: ../../build)
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SHAMROCK_BUILD="${SHAMROCK_BUILD:-$HERE/../../build}"
PY="${PLOUF_PYTHON:-python3}"
if [ ! -d "$SHAMROCK_BUILD/pysham" ]; then
    echo "plouf: no shamrock python module in $SHAMROCK_BUILD/pysham;" \
         "set SHAMROCK_BUILD to your shamrock build directory" >&2
    exit 1
fi
export PYTHONPATH="$HERE/src:$SHAMROCK_BUILD/pysham${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$SHAMROCK_BUILD${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ "$1" = "render" ]; then
    shift
    exec "$PY" -m plouf.render_movie "$@"
fi
if [ "$1" = "test" ]; then
    shift
    cd "$HERE" && exec "$PY" -m pytest "$@"
fi
exec "$PY" -m plouf.gui.app "$@"
